{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>go-vela/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/|\\.)elm\\.json$/"],
      "matchStrings": ["\"elm-version\"\\s*:\\s*\"(?<currentValue>.*)\""],
      "depNameTemplate": "elm/compiler",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/|\\.)elm\\.json$/"],
      "matchStrings": [
        "\"(?<depName>.*/.*?)\"\\s*:\\s*\"(?<currentValue>.*)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG NGINX_VERSION=(?<currentValue>\\d+\\.(?:0|[1-9]\\d*[02468])\\.\\d+)"
      ],
      "depNameTemplate": "nginx/nginx",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^release-(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG NGX_BROTLI_COMMIT=(?<currentDigest>[a-f0-9]{40})"],
      "currentValueTemplate": "master",
      "depNameTemplate": "google/ngx_brotli",
      "packageNameTemplate": "https://github.com/google/ngx_brotli",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["nginx/nginx"],
      "allowedVersions": "/^\\d+\\.(?:0|[02468]\\d*)\\./",
      "description": "Track NGINX stable releases, which use even-numbered minor versions."
    },
    {
      "allowedVersions": "!/nightly\\.\\d+$/",
      "matchPackageNames": ["/^@?parcel/"]
    },
    {
      "matchFileNames": ["elm.json"],
      "matchUpdateTypes": ["major"],
      "description": "Major upgrades of dependencies that are compatible likely require code changes, so we disable them to avoid noise.",
      "enabled": false
    },
    {
      "matchPackageNames": ["NoRedInk/elm-json-decode-pipeline"],
      "description": "This package was tagged out of order at one point, 1.0.2 is older than 1.0.1",
      "allowedVersions": "!/^1\\.0\\.2$/"
    },
    {
      "matchFileNames": ["elm.json"],
      "groupName": "elm dependencies"
    }
  ]
}
